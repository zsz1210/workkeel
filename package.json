{
  "name": "@zsz1210/workkeel",
  "version": "0.1.0-beta.1",
  "description": "A repository-native task coordination framework for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsz1210/workkeel.git"
  },
  "homepage": "https://github.com/zsz1210/workkeel#readme",
  "bugs": {"url": "https://github.com/zsz1210/workkeel/issues"},
  "keywords": ["ai-agents", "agent-coordination", "developer-tools", "workflow"],
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "project-overlay/",
    "packs/",
    "docs/README.md",
    "docs/adr/",
    "docs/assets/",
    "docs/concepts/",
    "docs/extensions/",
    "docs/getting-started/",
    "docs/integrations/",
    "docs/operations/",
    "README.md",
    "README.ja.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "workkeel": "./bin/workkeel.mjs",
    "temple": "./bin/temple.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "release:pack": "node scripts/pack-npm-release.mjs",
    "check:source-checkout": "node scripts/check-source-checkout.mjs",
    "check:publication": "node scripts/check-publication.mjs --working",
    "check:public-history": "node scripts/check-publication.mjs --history",
    "setup:hooks": "git config --local core.hooksPath .githooks",
    "check": "node scripts/check-repo.mjs && node scripts/check-import-boundary.mjs && node scripts/check-doc-links.mjs && node scripts/check-package.mjs",
    "test": "node scripts/test-groups.mjs full",
    "test:browser": "node scripts/verify-console-browser.mjs",
    "test:fast": "node scripts/test-groups.mjs fast",
    "test:core": "node scripts/test-groups.mjs core",
    "test:optional": "node scripts/test-groups.mjs optional",
    "test:daily": "node scripts/test-groups.mjs daily",
    "test:changed": "node scripts/test-groups.mjs changed",
    "verify:changed": "npm run check && node scripts/test-groups.mjs changed",
    "test:full": "node scripts/test-groups.mjs full",
    "test:full:verbose": "node scripts/test-groups.mjs full --verbose",
    "verify:fast": "npm run check && npm run test:fast",
    "verify:daily": "npm run check && npm run test:daily",
    "verify": "npm run check && npm run test:full"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "optionalDependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
