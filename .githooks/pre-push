#!/bin/sh
set -eu
revisions=""
while read -r local_ref local_oid remote_ref remote_oid; do
  # Only workkeel/* branches may be pushed; main changes through a reviewed PR.
  case "$remote_ref" in
    refs/heads/workkeel/?*) ;;
    *) echo "Refusing to push $remote_ref: only workkeel/* branches may be pushed" >&2; exit 1 ;;
  esac
  case "$local_oid" in
    0000000000000000000000000000000000000000) continue ;;
    *[!0-9a-f]*|'') echo "Invalid push object ID" >&2; exit 1 ;;
  esac
  revisions="$revisions $local_oid"
done
if [ -n "$revisions" ]; then
  node scripts/check-source-checkout.mjs
  # Only full hexadecimal Git object IDs reach this deliberate word splitting.
  node scripts/check-publication.mjs --history $revisions
fi
