{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.context-capsule/v2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "work_item",
    "position",
    "agent",
    "revision",
    "affected_paths",
    "tracker",
    "context_routes",
    "learning",
    "capabilities",
    "affected_path_overlaps",
    "parallel_execution",
    "retrieval",
    "warnings"
  ],
  "properties": {
    "schema_version": { "enum": ["temple.context-capsule/v1", "temple.context-capsule/v2"] },
    "generated_at": { "type": "string" },
    "work_item": { "type": "object" },
    "position": { "type": "object" },
    "agent": { "type": "object" },
    "revision": { "type": ["string", "null"] },
    "route": {
      "type": "object",
      "required": ["stage", "stage_source", "purpose", "fallback"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "stage_source": { "enum": ["explicit", "work-item-effective-state"] },
        "purpose": { "enum": ["primary", "integration", "recovery"] },
        "fallback": {
          "type": "object",
          "required": ["path", "policy", "automatic_expansion"],
          "properties": {
            "path": { "const": "TEMPLE.md" },
            "policy": { "enum": ["selected-for-recovery", "only-when-route-incomplete-or-authority-ambiguous"] },
            "automatic_expansion": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "affected_paths": { "type": "array", "items": { "type": "string" } },
    "specifications": { "type": "array" },
    "tracker": { "type": "object" },
    "context_routes": { "type": "array" },
    "learning": { "type": "array" },
    "capabilities": { "type": "array" },
    "affected_path_overlaps": { "type": "array" },
    "parallel_execution": { "type": "object" },
    "retrieval": { "type": "object" },
    "source_manifest": {
      "type": "object",
      "required": ["schema_version", "algorithm", "selection_digest", "source_count", "measured_source_count", "measured_bytes", "source_bodies_retained", "sources"],
      "properties": {
        "schema_version": { "const": "temple.context-source-manifest/v1" },
        "algorithm": { "const": "sha256-stream-v1" },
        "selection_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_count": { "type": "integer", "minimum": 0 },
        "measured_source_count": { "type": "integer", "minimum": 0 },
        "measured_bytes": { "type": "integer", "minimum": 0 },
        "source_bodies_retained": { "const": false },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "categories", "status", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "categories": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["work-item", "specification", "context-route", "learning", "capability", "operating-contract"] }
              },
              "status": { "enum": ["measured", "missing", "unsafe", "non-regular", "unreadable"] },
              "bytes": { "type": ["integer", "null"], "minimum": 0 },
              "sha256": {
                "anyOf": [
                  { "type": "null" },
                  { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "temple.context-capsule/v2" } },
        "required": ["schema_version"]
      },
      "then": { "required": ["route", "source_manifest"] }
    }
  ],
  "additionalProperties": false
}
