{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.matched-model-evaluation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "project_id",
    "observed_at",
    "expires_at",
    "task_shape",
    "rubric",
    "decision_contract",
    "baseline_profile_id",
    "candidates",
    "privacy"
  ],
  "properties": {
    "schema_version": { "const": "temple.matched-model-evaluation/v1" },
    "evaluation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "task_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_id", "lifecycle_stage", "task_kind", "risk_class", "context_profile_digest"],
      "properties": {
        "position_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lifecycle_stage": { "type": "string", "minLength": 1, "maxLength": 128 },
        "task_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "risk_class": { "enum": ["low", "standard", "high", "critical"] },
        "context_profile_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "required_case_ids", "minimum_score"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required_case_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "minimum_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "decision_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "minimum_effect", "alpha", "power", "pilot_variance"],
      "properties": {
        "method": { "const": "paired-sign-test-v1" },
        "minimum_effect": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "power": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "pilot_variance": { "type": "number", "minimum": 0 }
      }
    },
    "baseline_profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "provider_id",
          "requested_model",
          "effective_model",
          "requested_reasoning_effort",
          "effective_reasoning_effort",
          "cases"
        ],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "provider_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requested_model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "effective_model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "requested_reasoning_effort": { "type": "string", "minLength": 1, "maxLength": 128 },
          "effective_reasoning_effort": { "type": "string", "minLength": 1, "maxLength": 128 },
          "cases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "case_id",
                "input_digest",
                "source_revision",
                "quality_score",
                "quality_evidence_refs",
                "total_tokens",
                "latency_ms",
                "rework_count",
                "human_intervention_count"
              ],
              "properties": {
                "case_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "input_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "source_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
                "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
                "quality_evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
                },
                "total_tokens": { "type": "integer", "minimum": 0 },
                "latency_ms": { "type": "integer", "minimum": 0 },
                "rework_count": { "type": "integer", "minimum": 0 },
                "human_intervention_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_prompts_retained",
        "responses_retained",
        "hidden_reasoning_retained",
        "credentials_retained",
        "raw_provider_payloads_retained"
      ],
      "properties": {
        "raw_prompts_retained": { "const": false },
        "responses_retained": { "const": false },
        "hidden_reasoning_retained": { "const": false },
        "credentials_retained": { "const": false },
        "raw_provider_payloads_retained": { "const": false }
      }
    }
  }
}
