{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.collaboration/v2",
  "$defs": {
    "actor_policy": {
      "type": "object",
      "required": ["ordinary_development"],
      "properties": { "ordinary_development": { "enum": ["attributed", "verified"] } },
      "additionalProperties": false
    },
    "legacy": {
      "type": "object",
      "required": ["schema_version", "profile", "coordination_backend", "principals", "sponsorships", "memberships", "large_scale_validation"],
      "properties": {
        "schema_version": { "const": "temple.collaboration/v1" },
        "actor_policy": { "$ref": "#/$defs/actor_policy" },
        "profile": { "enum": ["solo", "collaborative", "high-assurance"] },
        "coordination_backend": { "const": "repository" },
        "principals": { "type": "array" },
        "sponsorships": { "type": "array" },
        "memberships": { "type": "array" },
        "large_scale_validation": {
          "type": "object",
          "required": ["status", "plan"],
          "properties": {
            "status": { "enum": ["not_run", "planned", "passed", "failed"] },
            "plan": { "type": "string", "minLength": 1 },
            "tested_revision": { "type": ["string", "null"] },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "principal": {
      "type": "object",
      "required": ["id", "display_name", "status", "active", "provider_identities", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^principal-[a-z0-9][a-z0-9-]*$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "enum": ["active", "suspended", "inactive"] },
        "active": { "type": "boolean" },
        "provider_identities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "subject", "status"],
            "properties": {
              "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
              "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
              "handle": { "type": ["string", "null"], "maxLength": 160 },
              "status": { "enum": ["active", "inactive"] },
              "verified_at": { "type": ["string", "null"], "format": "date-time" },
              "evidence_ref": { "type": ["string", "null"], "maxLength": 500 }
            },
            "additionalProperties": false
          }
        },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "sponsorship": {
      "type": "object",
      "required": ["principal_id", "agent_id", "status", "active", "created_at", "ended_at"],
      "properties": {
        "principal_id": { "type": "string", "pattern": "^principal-[a-z0-9][a-z0-9-]*$" },
        "agent_id": { "type": "string", "pattern": "^agent-[a-z0-9][a-z0-9-]*$" },
        "status": { "enum": ["active", "inactive"] },
        "active": { "type": "boolean" },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["basis", "evidence_refs", "risk_ceiling", "qualified_at", "review_after", "expires_at"],
      "properties": {
        "basis": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "risk_ceiling": { "enum": ["low", "standard", "high", "critical"] },
        "qualified_at": { "type": ["string", "null"], "format": "date-time" },
        "review_after": { "type": ["string", "null"], "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": ["position_id", "agent_id", "disciplines", "default", "status", "active", "qualification"],
      "properties": {
        "position_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "pattern": "^agent-[a-z0-9][a-z0-9-]*$" },
        "disciplines": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "default": { "type": "boolean" },
        "status": { "enum": ["provisional", "active", "suspended", "expired", "revoked"] },
        "active": { "type": "boolean" },
        "qualification": { "$ref": "#/$defs/qualification" }
      },
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "required": ["id", "principal_id", "authority", "scope", "risk_ceiling", "status", "approved_by", "granted_at", "expires_at", "revoked_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^grant-[a-z0-9][a-z0-9-]*$" },
        "principal_id": { "type": "string", "pattern": "^principal-[a-z0-9][a-z0-9-]*$" },
        "authority": { "enum": ["manage-identities", "manage-authority", "manage-recovery", "approve-critical-governance", "approve-high-risk-release"] },
        "scope": { "type": "string", "minLength": 1, "maxLength": 240 },
        "risk_ceiling": { "enum": ["low", "standard", "high", "critical"] },
        "status": { "enum": ["active", "suspended", "expired", "revoked"] },
        "approved_by": { "type": "array", "items": { "type": "string", "pattern": "^principal-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
        "granted_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "revoked_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "validation_gate": {
      "type": "object",
      "required": ["status", "tested_revision", "evidence", "participants", "environments", "plan"],
      "properties": {
        "status": { "enum": ["not_run", "planned", "passed", "failed"] },
        "tested_revision": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "participants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "environments": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "plan": { "type": ["string", "null"] },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "required": ["schema_version", "profile", "coordination_backend", "principals", "sponsorships", "memberships", "authority_grants", "bootstrap_owner", "recovery", "validation"],
      "properties": {
        "schema_version": { "const": "temple.collaboration/v2" },
        "actor_policy": { "$ref": "#/$defs/actor_policy" },
        "profile": { "enum": ["solo", "collaborative", "high-assurance"] },
        "coordination_backend": { "const": "repository" },
        "principals": { "type": "array", "items": { "$ref": "#/$defs/principal" } },
        "sponsorships": { "type": "array", "items": { "$ref": "#/$defs/sponsorship" } },
        "memberships": { "type": "array", "items": { "$ref": "#/$defs/membership" } },
        "authority_grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } },
        "bootstrap_owner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["principal_id", "status", "granted_at", "retired_at"],
              "properties": {
                "principal_id": { "type": "string", "pattern": "^principal-[a-z0-9][a-z0-9-]*$" },
                "status": { "enum": ["active", "retired"] },
                "granted_at": { "type": "string", "format": "date-time" },
                "retired_at": { "type": ["string", "null"], "format": "date-time" },
                "approved_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          ]
        },
        "recovery": {
          "type": "object",
          "required": ["status", "trustee_principal_ids", "threshold", "last_verified_at"],
          "properties": {
            "status": { "enum": ["not_configured", "ready", "degraded"] },
            "trustee_principal_ids": { "type": "array", "items": { "type": "string", "pattern": "^principal-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
            "threshold": { "type": "integer", "minimum": 0 },
            "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
            "approved_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "required": ["automated", "simulated_collaborative", "real_collaborative", "representative_pilot", "high_assurance_drill"],
          "properties": {
            "automated": { "$ref": "#/$defs/validation_gate" },
            "simulated_collaborative": { "$ref": "#/$defs/validation_gate" },
            "real_collaborative": { "$ref": "#/$defs/validation_gate" },
            "representative_pilot": { "$ref": "#/$defs/validation_gate" },
            "high_assurance_drill": { "$ref": "#/$defs/validation_gate" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/current" }
  ]
}
