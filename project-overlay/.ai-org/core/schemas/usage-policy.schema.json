{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.usage-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "objective", "data_scope", "task_shape", "seed_policy", "calibration", "cost", "autonomy"],
  "properties": {
    "schema_version": { "const": "temple.usage-policy/v1" },
    "objective": { "enum": ["quality-first", "balanced", "cost-first", "latency-first"] },
    "data_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_observations", "organization_sharing", "framework_sharing", "raw_prompts_retained", "hidden_reasoning_retained"],
      "properties": {
        "raw_observations": { "const": "project-local" },
        "organization_sharing": { "enum": ["disabled", "aggregated-opt-in"] },
        "framework_sharing": { "enum": ["disabled", "anonymous-aggregate-opt-in"] },
        "raw_prompts_retained": { "const": false },
        "hidden_reasoning_retained": { "const": false }
      }
    },
    "task_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_dimensions", "fallback_dimensions", "unknown_handling"],
      "properties": {
        "required_dimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fallback_dimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unknown_handling": { "const": "separate" }
      }
    },
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "profiles", "rules", "fallback_profile_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "superseded"] },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "model_class", "reasoning_class", "provider_id", "model", "reasoning_effort"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "model_class": { "enum": ["efficient", "balanced", "frontier"] },
              "reasoning_class": { "enum": ["light", "balanced", "deep"] },
              "provider_id": { "type": ["string", "null"], "minLength": 1 },
              "model": { "type": ["string", "null"], "minLength": 1 },
              "reasoning_effort": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "task_kinds", "risk_classes", "profile_id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "task_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "risk_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["low", "standard", "high", "critical"] } },
              "profile_id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "fallback_profile_id": { "type": "string", "minLength": 1 }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "recommendation_mode", "observation_threshold", "statistical_qualification", "required_evidence"],
      "properties": {
        "state": { "enum": ["cold-start", "exploratory", "calibrating", "calibrated", "stale", "invalid"] },
        "recommendation_mode": { "enum": ["shadow", "advisory", "automatic"] },
        "observation_threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed_work_items", "task_shapes", "samples_per_candidate", "purpose"],
          "properties": {
            "completed_work_items": { "type": "integer", "minimum": 1 },
            "task_shapes": { "type": "integer", "minimum": 1 },
            "samples_per_candidate": { "type": "integer", "minimum": 1 },
            "purpose": { "const": "diagnostic-only" }
          }
        },
        "statistical_qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "minimum_effect", "alpha", "power", "pilot_variance"],
          "properties": {
            "status": { "enum": ["unconfigured", "pilot", "configured", "satisfied", "stale", "invalid"] },
            "method": { "type": ["string", "null"], "minLength": 1 },
            "minimum_effect": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "alpha": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "power": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "pilot_variance": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "matched_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "maximum_age_days", "supported_method"],
          "properties": {
            "sources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\.ai-org/evaluations/model/[A-Za-z0-9._/-]+\\.json$"
              }
            },
            "maximum_age_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "supported_method": { "const": "paired-sign-test-v1" }
          }
        },
        "required_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounting_unit", "budget_limit", "source", "source_version", "effective_at", "status", "token_limits_are_financial_limits"],
      "properties": {
        "accounting_unit": { "const": "credits" },
        "budget_limit": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": ["string", "null"], "minLength": 1 },
        "source_version": { "type": ["string", "null"], "minLength": 1 },
        "effective_at": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["unknown", "configured", "stale", "invalid"] },
        "token_limits_are_financial_limits": { "const": false }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "routine_decision", "automatic_when", "approval_triggers"],
      "properties": {
        "mode": { "const": "exceptions-only" },
        "routine_decision": { "const": "automatic" },
        "automatic_when": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "approval_triggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
