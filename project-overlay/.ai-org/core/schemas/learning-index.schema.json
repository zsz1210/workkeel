{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-org.learning-index",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "enum": ["ai-org.learning-index/v1", "ai-org.learning-index/v2"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "summary",
          "status",
          "confidence",
          "tags",
          "applies_to",
          "source_work_items",
          "path",
          "updated_at",
          "last_validated_at",
          "promotion"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(LESSON|PRACTICE)-[0-9]{4,}$" },
          "kind": { "enum": ["lesson", "practice"] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "status": { "enum": ["candidate", "validated", "active", "deprecated"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "applies_to": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_work_items": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" }
          },
          "path": { "type": "string" },
          "updated_at": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "format": "date-time" }
            ]
          },
          "last_validated_at": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "promotion": {
            "type": "object",
            "required": ["target", "status", "reference"],
            "properties": {
              "target": { "enum": ["none", "practice", "skill", "automated-check", "adr", "instruction"] },
              "status": { "enum": ["none", "proposed", "accepted", "rejected", "deferred"] },
              "reference": { "type": ["string", "null"] },
              "proposal_id": { "type": ["string", "null"], "pattern": "^SKILL-PROPOSAL-[0-9]{4,}$" },
              "review_after": { "type": ["string", "null"], "format": "date-time" },
              "work_item_id": { "type": ["string", "null"], "pattern": "^WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" }
            },
            "additionalProperties": false
          },
          "derived_from": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^LESSON-[0-9]{4,}$" } },
          "owner_position": { "type": ["string", "null"] },
          "revalidation": {
            "type": "object",
            "required": ["last_result", "review_after", "evidence_refs", "history"],
            "properties": {
              "last_result": { "enum": [null, "confirmed", "narrowed", "contradicted"] },
              "review_after": { "type": ["string", "null"], "format": "date-time" },
              "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["result", "validated_at", "validated_by", "evidence_refs", "review_after"],
                  "properties": {
                    "result": { "enum": ["confirmed", "narrowed", "contradicted"] },
                    "validated_at": { "type": "string", "format": "date-time" },
                    "validated_by": { "type": "string", "minLength": 1 },
                    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "review_after": { "type": ["string", "null"], "format": "date-time" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "lesson" } } },
            "then": {
              "properties": {
                "id": { "pattern": "^LESSON-[0-9]{4,}$" },
                "status": { "enum": ["candidate", "validated", "deprecated"] },
                "path": { "pattern": "^\\.ai-org/learning/lessons/LESSON-[0-9]{4,}\\.md$" }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "practice" } } },
            "then": {
              "properties": {
                "id": { "pattern": "^PRACTICE-[0-9]{4,}$" },
                "status": { "enum": ["candidate", "active", "deprecated"] },
                "path": { "pattern": "^\\.ai-org/learning/practices/PRACTICE-[0-9]{4,}\\.md$" }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "ai-org.learning-index/v2" } }, "required": ["schema_version"] },
      "then": { "properties": { "entries": { "items": { "required": ["derived_from", "owner_position", "revalidation"] } } } }
    }
  ],
  "additionalProperties": false
}
