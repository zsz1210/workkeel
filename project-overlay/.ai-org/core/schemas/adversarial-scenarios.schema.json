{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.adversarial-scenarios/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "outcomes", "profiles", "scenarios"],
  "properties": {
    "schema_version": { "const": "temple.adversarial-scenarios/v1" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "outcomes": {
      "const": ["prevented", "detected", "recovered", "unknown", "escaped"]
    },
    "profiles": {
      "const": ["solo", "collaborative", "high-assurance"]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "profiles", "attempted_violation", "expected", "cleanup_boundary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": { "type": "string", "minLength": 1 },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["solo", "collaborative", "high-assurance"] }
          },
          "attempted_violation": { "type": "string", "minLength": 1 },
          "cleanup_boundary": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptable_outcomes", "required_checks", "required_evidence", "allowed_side_effects"],
            "properties": {
              "acceptable_outcomes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["prevented", "detected", "recovered"] }
              },
              "required_checks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["gate_integrity", "revision_correctness", "separation_of_duties", "external_authority", "context_recovery", "notification_quality"] }
              },
              "required_evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "allowed_side_effects": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
