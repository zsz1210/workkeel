{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.resources/v1",
  "type": "object",
  "required": ["schema_version", "resources", "reservations"],
  "properties": {
    "schema_version": { "const": "temple.resources/v1" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "capacity", "description", "active"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 100 },
          "description": { "type": "string" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "resource_id", "units", "worker_id", "work_item_id", "status", "reserved_at", "released_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "resource_id": { "type": "string", "minLength": 1 },
          "units": { "type": "integer", "minimum": 1 },
          "worker_id": { "type": "string", "minLength": 1 },
          "work_item_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "released"] },
          "reserved_at": { "type": "string", "format": "date-time" },
          "released_at": { "type": ["string", "null"], "format": "date-time" },
          "release_reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
