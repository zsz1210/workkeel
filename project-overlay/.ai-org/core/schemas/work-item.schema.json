{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.work-item/v1",
  "type": "object",
  "required": ["schema_version", "id", "title", "state", "owner_position", "evidence"],
  "properties": {
    "schema_version": { "const": "temple.work-item/v1" },
    "id": { "type": "string", "pattern": "^WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" },
    "title": { "type": "string", "minLength": 1 },
    "state": { "type": "string" },
    "owner_position": { "type": "string" },
    "assigned_agent_id": { "type": ["string", "null"] },
    "proposed_by": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "principal_id", "position_id", "actor_provenance", "proposed_at"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "principal_id": { "type": "string", "minLength": 1 },
        "position_id": { "type": "string", "minLength": 1 },
        "actor_provenance": { "type": "object" },
        "proposed_at": { "type": "string", "format": "date-time" }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "rework_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "returned_at", "from_state", "reviewer_agent_id", "reviewer_claim_id", "rejected_revision", "reason", "findings", "scope_digest", "retained_requirements", "retired_gate_evidence", "retired_candidate_fields", "handoff_refs"],
        "additionalProperties": false,
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "returned_at": { "type": "string", "format": "date-time" },
          "from_state": { "enum": ["test", "eval", "independent_qa"] },
          "reviewer_agent_id": { "type": "string", "minLength": 1 },
          "reviewer_claim_id": { "type": "string", "minLength": 1 },
          "rejected_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "scope_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reason": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "findings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "retained_requirements": { "type": "array", "items": { "type": "string" } },
          "retired_gate_evidence": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
          "retired_candidate_fields": { "type": "object" },
          "handoff_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "affected_paths": { "type": "array", "items": { "type": "string" } },
    "context_refs": { "type": "array", "items": { "type": "string" } },
    "spec_refs": { "$ref": "#/$defs/documentReferences" },
    "ux_refs": { "$ref": "#/$defs/documentReferences" },
    "ui_refs": { "$ref": "#/$defs/documentReferences" },
    "contract_refs": { "$ref": "#/$defs/documentReferences" },
    "specification_mode": { "enum": ["gate-evidence", "indexed"] },
    "ui_delivery_mode": {
      "type": ["string", "null"],
      "enum": ["not-applicable", "code-first", "preview-first", "design-led", null]
    },
    "workflow_profile": { "enum": ["lean", "standard", "high-assurance"] },
    "risk_tier": { "enum": ["low", "standard", "high", "critical"] },
    "profile_assessment": {
      "type": "object",
      "required": ["requested_profile", "effective_profile", "scope_class", "escalation_triggers", "rationale", "evidence_refs", "evaluated_at"],
      "properties": {
        "requested_profile": { "enum": ["lean", "standard", "high-assurance"] },
        "effective_profile": { "enum": ["lean", "standard", "high-assurance"] },
        "scope_class": { "enum": ["bounded", "ordinary", "cross-system"] },
        "escalation_triggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "rationale": { "type": "string" },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "escalated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "assurance": {
      "type": "object",
      "required": ["profile", "policy_schema", "artifact_depth", "minimum_approvals", "rollback_status", "external_action_performed"],
      "properties": {
        "profile": { "const": "high-assurance" },
        "policy_schema": { "const": "temple.high-assurance/v1" },
        "artifact_depth": { "enum": ["lean", "standard", "controlled"] },
        "minimum_approvals": { "type": "integer", "minimum": 1 },
        "rollback_status": { "enum": ["planned", "verified"] },
        "external_action_performed": { "const": false }
      },
      "additionalProperties": false
    },
    "parent_work_item_id": { "type": ["string", "null"] },
    "tracker_visibility": { "enum": ["internal", "team-visible"] },
    "tracker_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "item_id", "url", "role"],
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "item_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "role": { "enum": ["primary", "supporting"] }
        },
        "additionalProperties": false
      }
    },
    "tracker_reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider_id",
          "item_id",
          "observation_revision",
          "resolution",
          "recorded_at",
          "recorded_by",
          "evidence_ref",
          "external_write_performed"
        ],
        "properties": {
          "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "item_id": { "type": "string", "minLength": 1 },
          "observation_revision": { "type": "string", "minLength": 1 },
          "resolution": { "enum": ["acknowledge", "keep-temple", "accept-external", "defer"] },
          "recorded_at": { "type": "string", "format": "date-time" },
          "recorded_by": { "type": "string", "minLength": 1 },
          "evidence_ref": {
            "type": "string",
            "pattern": "^\\.ai-org/artifacts/tracker-reconciliations/[^/]+\\.json$"
          },
          "external_write_performed": { "const": false }
        },
        "additionalProperties": false
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "required_disciplines": { "type": "array", "items": { "type": "string" } },
    "stage_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["disciplines", "resources"],
        "properties": {
          "disciplines": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "resources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["resource_id", "units"],
              "properties": {
                "resource_id": { "type": "string", "minLength": 1 },
                "units": { "type": "integer", "minimum": 1, "maximum": 100 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "base_revision": { "type": ["string", "null"] },
    "parallel_mode": { "enum": ["pending", "parallel", "sequential", "blocked"] },
    "integration_owner_agent_id": { "type": ["string", "null"] },
    "planned_agent_id": { "type": ["string", "null"] },
    "shared_contract_refs": { "type": "array", "items": { "type": "string" } },
    "contract_status": { "enum": ["not_required", "draft", "stable"] },
    "overlap_resolution": { "type": "array", "items": { "type": "string" } },
    "claim": { "type": ["object", "null"] },
    "claims": { "type": "array", "items": { "type": "object" } },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "release_gate_result": { "enum": ["go", "no-go"] },
    "lifecycle_outcome": { "enum": ["accepted", "no-go", "inconclusive", "cancelled"] },
    "closeout_reasons": { "type": "array", "items": { "type": "string" } },
    "next_position": { "type": ["string", "null"] }
  },
  "$defs": {
    "documentReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "revision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workflow_profile": { "const": "high-assurance" } },
        "required": ["workflow_profile"]
      },
      "then": { "required": ["assurance"] }
    },
    {
      "if": { "properties": { "specification_mode": { "const": "gate-evidence" } }, "required": ["specification_mode"] },
      "then": { "properties": { "spec_refs": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "ui_refs": { "minItems": 1 } }, "required": ["ui_refs"] },
      "then": { "properties": { "ui_delivery_mode": { "enum": ["code-first", "preview-first", "design-led"] } } }
    },
    {
      "if": { "properties": { "ui_delivery_mode": { "const": "not-applicable" } }, "required": ["ui_delivery_mode"] },
      "then": { "properties": { "ui_refs": { "maxItems": 0 } } }
    },
    {
      "if": {
        "properties": { "ui_delivery_mode": { "enum": ["preview-first", "design-led"] } },
        "required": ["ui_delivery_mode"]
      },
      "then": { "properties": { "ui_refs": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": true
}
