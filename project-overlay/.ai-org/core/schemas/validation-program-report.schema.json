{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.validation-program-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "program", "status", "qualification", "participants", "qualified_samples", "totals", "issues", "claims", "authority", "privacy", "canonical_state_changed", "external_action_performed"],
  "properties": {
    "schema_version": { "const": "temple.validation-program-report/v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifest_digest", "coordinator_project_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "manifest_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "coordinator_project_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "status": { "enum": ["qualified-observation", "not-qualified"] },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_completed_work_items", "qualified_completed_work_items", "qualified_completed_work_item_ids", "required_task_shapes", "qualified_task_shapes", "qualified_task_shape_ids", "threshold_met"],
      "properties": {
        "required_completed_work_items": { "type": "integer", "minimum": 1 },
        "qualified_completed_work_items": { "type": "integer", "minimum": 0 },
        "qualified_completed_work_item_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" } },
        "required_task_shapes": { "const": 2 },
        "qualified_task_shapes": { "type": "integer", "minimum": 0 },
        "qualified_task_shape_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "threshold_met": { "type": "boolean" }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "revision", "baseline_generated_at", "baseline_status", "qualified_completed_work_items", "qualified_task_shapes", "issues"],
        "properties": {
          "project_id": { "type": "string", "minLength": 1 },
          "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
          "baseline_generated_at": { "type": ["string", "null"], "format": "date-time" },
          "baseline_status": { "type": "string", "minLength": 1 },
          "qualified_completed_work_items": { "type": "integer", "minimum": 0 },
          "qualified_task_shapes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "qualified_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project_id", "work_item_id", "task_id", "task_shape", "model", "observations", "tokens"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "project_id": { "type": "string", "minLength": 1 },
          "work_item_id": { "type": "string", "pattern": "^WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" },
          "task_id": { "type": "string", "minLength": 1 },
          "task_shape": { "type": "string", "minLength": 3 },
          "model": { "type": "string", "minLength": 1 },
          "observations": { "type": "integer", "minimum": 0 },
          "tokens": { "$ref": "#/$defs/tokens" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens", "cached_input_ratio", "monetary_cost", "price_source", "cost_status"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "monetary_cost": { "const": null },
        "price_source": { "const": null },
        "cost_status": { "const": "unknown" }
      }
    },
    "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["savings_claim_allowed", "cost_claim_allowed", "model_quality_claim_allowed", "routing_claim_allowed", "enterprise_readiness_claim_allowed", "automatic_routing"],
      "properties": {
        "savings_claim_allowed": { "const": false },
        "cost_claim_allowed": { "const": false },
        "model_quality_claim_allowed": { "const": false },
        "routing_claim_allowed": { "const": false },
        "enterprise_readiness_claim_allowed": { "const": false },
        "automatic_routing": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_authority", "participant_lifecycle_mutations_performed", "release_authority_granted"],
      "properties": {
        "lifecycle_authority": { "const": "participant-repositories" },
        "participant_lifecycle_mutations_performed": { "const": false },
        "release_authority_granted": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_prompts_retained", "hidden_reasoning_retained", "credentials_retained"],
      "properties": {
        "raw_prompts_retained": { "const": false },
        "hidden_reasoning_retained": { "const": false },
        "credentials_retained": { "const": false }
      }
    },
    "canonical_state_changed": { "const": false },
    "external_action_performed": { "const": false }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
