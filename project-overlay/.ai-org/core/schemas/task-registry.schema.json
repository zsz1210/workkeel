{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temple.tasks/v1",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": { "const": "temple.tasks/v1" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "work_item_id", "position_id", "agent_id", "suggested_title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[0-9]{4,}$" },
          "work_item_id": { "type": "string", "pattern": "^WI-(?:[0-9]{4,}|[0-9]{8}-[A-F0-9]{10})$" },
          "position_id": { "type": "string" },
          "agent_id": { "type": "string" },
          "suggested_title": { "type": "string" },
          "status": { "enum": ["setup", "active", "waiting", "attention", "completed", "archived"] },
          "thread_id": { "type": ["string", "null"] },
          "client_thread_id": { "type": ["string", "null"] },
          "host_id": { "type": ["string", "null"] },
          "requested_reasoning_effort": { "type": ["string", "null"], "maxLength": 80 },
          "observed_thread_reasoning_effort": { "type": ["string", "null"], "maxLength": 80 },
          "effective_turn_reasoning_effort": { "type": ["string", "null"], "maxLength": 80 },
          "reasoning_effort": { "type": ["string", "null"], "maxLength": 80 },
          "reasoning_effort_source": { "enum": ["provider-turn", "provider-thread", "canonical-requested", "unknown", null] },
          "current_revision": { "type": ["string", "null"] },
          "principal_id": { "type": ["string", "null"] },
          "claim_id": { "type": ["string", "null"] },
          "base_revision": { "type": ["string", "null"] },
          "branch": { "type": ["string", "null"] },
          "worktree": { "type": ["string", "null"] },
          "worker_id": { "type": ["string", "null"], "pattern": "^worker-" },
          "registered_by": { "type": ["string", "null"] },
          "last_updated_by": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
