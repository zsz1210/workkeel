{
  "schema_version": "temple.policies/v1",
  "canonical_state": {
    "chat_is_canonical": false,
    "chat_title_is_identifier": false,
    "required_sources": ["repository_files", "git_state", "verification_evidence", "approval_records"]
  },
  "staffing": {
    "all_positions_must_be_assigned": true,
    "one_agent_may_hold_multiple_positions": true,
    "developer_and_independent_qa_must_differ": true
  },
  "human_authority": {
    "owns": ["business_truth", "priority", "budget", "external_commitment", "high_risk_release_approval"]
  },
  "handoff": {
    "required_fields": ["work_item_id", "input_revision", "completed", "evidence", "unresolved", "next_position"]
  },
  "codex_tasks": {
    "canonical_registry": ".ai-org/project/tasks.json",
    "suggested_title_format": "WI-#### · short goal · Position (Agent Name)",
    "main_control_title_format": "Project · control scope · Primary Position (Agent Name)",
    "suggested_title_max_code_points": 58,
    "thread_id_is_identifier": true,
    "registry_refresh_renames_app_task": false,
    "automatic_archive": false
  },
  "external_trackers": {
    "configuration": ".ai-org/project/tracker.json",
    "company_coordination_may_remain_external": true,
    "internal_ai_decomposition_stays_in_work_items": true,
    "credentials_in_repository": false,
    "external_completion_advances_lifecycle": false,
    "write_back_requires_explicit_authorization": true,
    "protected_temple_fields": [
      "lifecycle_state",
      "specification_refs",
      "interface_contracts",
      "gate_evidence",
      "claim",
      "tested_revision",
      "release_decision"
    ]
  },
  "parallel_orchestration": {
    "generated_plan": ".ai-org/views/parallel-plan.json",
    "parallel_by_default_when_safe": true,
    "only_first_fresh_wave_is_dispatchable": true,
    "planning_creates_tasks_or_claims": false,
    "preparation_records_claim_and_resources": true,
    "preparation_creates_runtime": false,
    "sequential_fallback_when_runtime_has_no_concurrency": true,
    "integration_join_required_before_dependent_work": true,
    "replan_after_canonical_change": true
  },
  "release_gate": {
    "requires": ["accepted_scope", "test_evidence", "evaluation_report", "independent_qa_report", "rollback_plan"],
    "human_approval_when": ["production_change", "external_message", "irreversible_action", "material_cost", "sensitive_data"]
  }
}
