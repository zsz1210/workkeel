---
config:
  theme: base
  fontFamily: "Noto Sans JP, Hiragino Sans, Inter, Arial, sans-serif"
  block:
    padding: 16
  themeVariables:
    background: "#0b0f14"
    primaryTextColor: "#f8fafc"
    lineColor: "#94a3b8"
---
block-beta
  columns 2
  R["各段階で決める · Position · Context · Execution Route"]:2
  H["人の判断"]:2
  S1["1 · 目的を定める"] S2["2 · 境界を承認"]
  D["成果をつくる"]:2
  S4["4 · 成果物をつくる"] S3["3 · 進め方を設計"]
  A["保証"]:2
  S5["5 · テスト・評価"] S6["6 · 独立レビュー"]
  space S7["7 · 判断して完了"]
  P["PROFILE + リスク · Review / Release Gate の深さを決める"]:2
  E["PROJECT REPOSITORY · 根拠を蓄積"]:2

  S1 --> S2
  S2 --> S3
  S3 --> S4
  S4 --> S5
  S5 --> S6
  S6 --> S7

  classDef lane fill:#0b0f14,stroke:#0b0f14,color:#94a3b8,font-weight:700,font-size:14px;
  classDef human fill:#172033,stroke:#60a5fa,color:#f8fafc,stroke-width:2px;
  classDef delivery fill:#0f2f2d,stroke:#2dd4bf,color:#f8fafc,stroke-width:2px;
  classDef assurance fill:#33280f,stroke:#fbbf24,color:#f8fafc,stroke-width:2px;
  classDef route fill:#102329,stroke:#38bdf8,color:#e0f2fe,stroke-width:1px;
  classDef profile fill:#211d16,stroke:#a78bfa,color:#ede9fe,stroke-width:1px;
  classDef evidence fill:#171c24,stroke:#64748b,color:#e2e8f0,stroke-width:2px;

  class H,D,A lane
  class R route
  class S1,S2 human
  class S3,S4 delivery
  class S5,S6,S7 assurance
  class P profile
  class E evidence
