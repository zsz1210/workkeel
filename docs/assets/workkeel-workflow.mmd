---
config:
  theme: base
  fontFamily: "Arial, sans-serif"
  themeVariables:
    primaryTextColor: "#183c40"
    lineColor: "#59787c"
    fontSize: "16px"
  flowchart:
    htmlLabels: false
    curve: basis
    nodeSpacing: 34
    rankSpacing: 40
---
flowchart LR
  A("01 · APPROVE<br/>Goal, scope and checks") --> B("02 · PLAN<br/>Steps, Skills and models")
  B --> C("03 · EXECUTE<br/>Coding runtime + tools")
  C --> D{"04 · REVIEW<br/>Exact candidate"}
  D -->|pass| E("05 · ACCEPT<br/>Recorded decision")
  D -->|rework| C
  C -.-> R[("Checkpoints + evidence<br/>Resume without blind replay")]
  R -.-> C
  classDef plan fill:#edf4f3,stroke:#aac6c3,color:#183c40,stroke-width:1.5px;
  classDef execute fill:#076b67,stroke:#076b67,color:#ffffff,stroke-width:2px;
  classDef review fill:#fff1dc,stroke:#c9944b,color:#553814,stroke-width:1.5px;
  classDef record fill:#f5f6f4,stroke:#b6c2c0,color:#4b6263,stroke-width:1px;
  class A,B,E plan
  class C execute
  class D review
  class R record
