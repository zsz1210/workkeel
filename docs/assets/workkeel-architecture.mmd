---
config:
  theme: base
  fontFamily: "Arial, sans-serif"
  themeVariables:
    primaryTextColor: "#183c40"
    lineColor: "#59787c"
    fontSize: "20px"
    edgeLabelBackground: "#ffffff"
    clusterBkg: "#f6f8f7"
    clusterBorder: "#baccca"
  flowchart:
    htmlLabels: false
    curve: basis
    nodeSpacing: 36
    rankSpacing: 32
---
flowchart LR
  P[("PROJECT REPOSITORY<br/>Task contract + Skills<br/>Model policy + evidence")]
  subgraph W[WORKKEEL]
    direction TB
    T("TASK LIFECYCLE<br/>Claim · handoff · review")
    G("OPTIONAL WORKFLOW RUNNER<br/>LangGraph + model routing")
    S[("LOCAL RECOVERY STATE<br/>SQLite + dispatch journal")]
    T -->|approved scope| G
    G <--> S
  end
  subgraph H[EXECUTION HOST]
    direction TB
    R("CODING RUNTIME<br/>Codex subscription<br/>Pinned Luna / Sol")
    F("HOST TOOLS<br/>Scoped files + commands<br/>Enforced permissions")
    R --> F
  end
  P -->|contracts| W
  W <-->|dispatch / results| H
  classDef repo fill:#edf4f3,stroke:#aac6c3,color:#183c40,stroke-width:1.5px;
  classDef main fill:#076b67,stroke:#076b67,color:#ffffff,stroke-width:2px;
  classDef runtime fill:#fff1dc,stroke:#c9944b,color:#553814,stroke-width:1.5px;
  classDef state fill:#ffffff,stroke:#b6c2c0,color:#4b6263,stroke-width:1px;
  class P,T repo
  class G main
  class R,F runtime
  class S state
